// BSS Darkstore Replenishment — data model
// See replenishment-tool-brief.md for the decisions behind this schema.
//
// Par resolution (draft):  par(item,store) = ParOverride(item,store)
//                                         ?? ParTemplate(item, store.tier)
//                                         ?? 0
// Requirement:             suggested = max( par - max(live,0), 0 )
// Finalize freezes par_used/live_used/suggested/adjusted into RunRequirement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Partner {
  HK
  CZ
  REBEL
}

enum Tier {
  A
  B
  C
}

enum RunStatus {
  DRAFT
  FINALIZED
}

enum RunPhase {
  PROCUREMENT
  DISTRIBUTION
}

enum StockSource {
  PRIME_CSV
  MANUAL
}

enum Role {
  ADMIN
  MEMBER
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Item {
  id          String   @id @default(cuid())
  name        String
  category    String?
  mrp         Float?
  unit        String   @default("pcs")
  erpnextCode String?  @map("erpnext_code") // ERPNext item_code, filled over time
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  partnerSkus  ItemPartnerSku[]
  parTemplates ParTemplate[]
  parOverrides ParOverride[]
  runStocks    RunStock[]
  requirements RunRequirement[]
  unmapped     UnmappedSku[]

  @@index([category])
  @@map("item")
}

// One internal item, different SKU code per partner (same product across partners).
model ItemPartnerSku {
  id      String  @id @default(cuid())
  itemId  String  @map("item_id")
  partner Partner
  skuCode String  @map("sku_code") // canonicalized string, e.g. "16223"

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([partner, skuCode]) // a partner SKU maps to exactly one item
  @@unique([itemId, partner]) // one code per partner per item
  @@index([skuCode])
  @@map("item_partner_sku")
}

// ---------------------------------------------------------------------------
// Stores / warehouses
// ---------------------------------------------------------------------------

model Store {
  id                 String   @id @default(cuid())
  name               String
  partner            Partner
  tier               Tier     @default(B)
  active             Boolean  @default(true)
  erpnextWarehouseId String?  @unique @map("erpnext_warehouse_id") // e.g. "HK- BKC - HIHPL"
  locationAliases    String[] @map("location_aliases") // Prime CSV Location strings -> this store
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  parOverrides ParOverride[]
  runStocks    RunStock[]
  requirements RunRequirement[]

  @@index([partner])
  @@map("store")
}

// ---------------------------------------------------------------------------
// Par levels
// ---------------------------------------------------------------------------

// Tier default par for an item. Stores inherit unless overridden.
model ParTemplate {
  id     String @id @default(cuid())
  itemId String @map("item_id")
  tier   Tier
  qty    Int

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, tier])
  @@map("par_template")
}

// Per-item-per-store override; wins over the tier template.
model ParOverride {
  id      String @id @default(cuid())
  itemId  String @map("item_id")
  storeId String @map("store_id")
  qty     Int

  item  Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([itemId, storeId])
  @@map("par_override")
}

// ---------------------------------------------------------------------------
// Runs
// ---------------------------------------------------------------------------

model Run {
  id          String    @id @default(cuid())
  runDate     DateTime  @map("run_date") @db.Date
  label       String    @default("")
  status      RunStatus @default(DRAFT)
  phase       RunPhase  @default(PROCUREMENT) // procurement -> (receive) -> distribution
  receivedAt  DateTime? @map("received_at") // when goods received; unlocks distribution
  createdById String?   @map("created_by_id")
  finalizedAt DateTime? @map("finalized_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  createdBy    User?            @relation(fields: [createdById], references: [id])
  stocks       RunStock[]
  requirements RunRequirement[]
  unmapped     UnmappedSku[]

  @@index([runDate])
  @@map("run")
}

// Live stock per item per store within a draft run (mutable until finalize).
model RunStock {
  id         String      @id @default(cuid())
  runId      String      @map("run_id")
  storeId    String      @map("store_id")
  itemId     String      @map("item_id")
  liveQty    Int         @map("live_qty")
  source     StockSource
  uploadedAt DateTime    @default(now()) @map("uploaded_at")

  run   Run   @relation(fields: [runId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  item  Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([runId, storeId, itemId])
  @@index([runId])
  @@map("run_stock")
}

// Requirement line. Frozen at finalize (par_used/live_used/suggested immutable).
// `adjusted` is the exported number; defaults to suggested.
model RunRequirement {
  id        String   @id @default(cuid())
  runId     String   @map("run_id")
  storeId   String   @map("store_id")
  itemId    String   @map("item_id")
  parUsed   Int      @map("par_used")
  liveUsed  Int      @map("live_used")
  suggested Int
  adjusted  Int
  edited    Boolean  @default(false) // user changed adjusted; recompute won't reset it
  updatedAt DateTime @updatedAt @map("updated_at") // optimistic concurrency

  run   Run   @relation(fields: [runId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  item  Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([runId, storeId, itemId])
  @@index([runId])
  @@map("run_requirement")
}

// SKU seen in an upload that didn't match any item for that partner.
model UnmappedSku {
  id             String   @id @default(cuid())
  runId          String   @map("run_id")
  partner        Partner
  skuCode        String   @map("sku_code")
  rawName        String?  @map("raw_name")
  liveQty        Int?     @map("live_qty")
  resolvedItemId String?  @map("resolved_item_id")
  ignored        Boolean  @default(false) // dismissed by user; hidden from the panel
  createdAt      DateTime @default(now()) @map("created_at")

  run          Run   @relation(fields: [runId], references: [id], onDelete: Cascade)
  resolvedItem Item? @relation(fields: [resolvedItemId], references: [id])

  @@unique([runId, partner, skuCode])
  @@map("unmapped_sku")
}

// ---------------------------------------------------------------------------
// Admin: settings / feature flags (key/value, admin-editable, global)
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("setting")
}

// ---------------------------------------------------------------------------
// Procurement: the 3 source places + category routing
// ---------------------------------------------------------------------------

// One of the three places a Material Request is raised to.
model MaterialSource {
  id                 String   @id @default(cuid())
  name               String // display, e.g. "Byculla Mithai Packing"
  erpnextWarehouseId String?  @map("erpnext_warehouse_id")
  sortOrder          Int      @default(0) @map("sort_order")

  categories CategorySource[]

  @@map("material_source")
}

// Routes an item category to one of the three source places.
model CategorySource {
  category String @id // item.category
  sourceId String @map("source_id")

  source MaterialSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("category_source")
}

// ---------------------------------------------------------------------------
// Auth (NextAuth / Auth.js with Prisma adapter, magic-link email)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          Role      @default(MEMBER)

  accounts Account[]
  sessions Session[]
  runs     Run[]

  @@map("user")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}
